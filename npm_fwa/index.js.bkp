const puppeteer = require('puppeteer');
const PuppeteerHar = require('puppeteer-har');
const path = require('path');
const fs = require('fs');
const mkdirp = require('mkdirp');
const os = require('os');
const { execSync } = require('child_process');

// ===== CONFIGURAÇÃO =====
const DASH_URL = process.env.DASH_URL || 'https://172.31.0.220';  // ← http→https (QUIC/HTTP3)
const FORCE_QUIC = (process.env.FORCE_QUIC || 'true') !== 'false';  // false = usar Alt-Svc (fallback TCP possível)
const DURATION_SEC = parseInt(process.env.DURATION_SEC || '180', 10);
const CLIENT_ID = process.env.CLIENT_ID || os.hostname();
const COLLECTOR_URL = process.env.COLLECTOR_URL || 'http://192.168.110.41:9999/upload';
const HEADLESS = process.env.HEADLESS === 'true';
const MAX_TIMEOUT_SEC = Math.max(240, DURATION_SEC * 1.3); // máximo 1.5x duração ou 4 min

(async () => {
  const HAR_DIR = path.join(os.homedir(), 'har_logs');
  mkdirp.sync(HAR_DIR);

  const timestamp = new Date().toISOString().replace(/[:.]/g, '-');
  const harPath = path.join(HAR_DIR, `${CLIENT_ID}_${timestamp}.har`);
  const metricsPath = path.join(HAR_DIR, `${CLIENT_ID}_${timestamp}_metrics.csv`);

  console.log(`🚀 [${CLIENT_ID}] Iniciando coleta — ${DURATION_SEC}s`);
  console.log(`   URL: ${DASH_URL}`);
  console.log(`   HAR: ${harPath}`);

  const browser = await puppeteer.launch({
    headless: HEADLESS,
    executablePath: '/usr/bin/google-chrome-stable',
    ignoreHTTPSErrors: true,              // ← aceita o certificado autoassinado
    args: [
      '--no-sandbox',
      '--disable-setuid-sandbox',
      '--autoplay-policy=no-user-gesture-required',
      '--disable-application-cache',
      '--disable-cache',
      '--disk-cache-size=0',
      '--ignore-certificate-errors',      // ← reforço via flag do Chrome (TCP/TLS)
      '--ignore-certificate-errors-spki-list=6LyMlhPlTCXv2m6y897sA2GvEtB2jnpMpedlW5HN0Rg=',  // ← cobre QUIC (autoassinado)
      '--enable-quic',                    // ← garante QUIC/HTTP3 habilitado
      ...(FORCE_QUIC ? ['--origin-to-force-quic-on=172.31.0.220:443'] : []),  // ← força QUIC (falha se UDP bloqueado)
    ]
  });

  try {
    // Cache desabilitado via flags + setCacheEnabled → cada execução mede rede real (5G)
    const context = await browser.createBrowserContext();
    const page = await context.newPage();
    await page.setCacheEnabled(false);

    const har = new PuppeteerHar(page);

    console.log("🌐 Acessando página DASH...");
    await har.start({ path: harPath });

    await page.goto(DASH_URL, { waitUntil: 'domcontentloaded', timeout: 30000 });
    console.log("✅ Página carregada.");

    // Protocolo real negociado: h3 = HTTP/3/QUIC, h2 = HTTP/2, http/1.1 = fallback
    const protos = await page.evaluate(() =>
      [...new Set(performance.getEntries().map(e => e.nextHopProtocol).filter(Boolean))]
    );
    console.log(`🔌 Protocolos usados: ${protos.join(', ')}`);

    // Clica no ABR desejado (BOLA por padrão)
    await page.evaluate(() => {
      const btn = document.querySelector('#btn-bola');
      if (btn) btn.click();
    });

    await page.waitForSelector('video', { timeout: 15000 });
    console.log("🎬 Player detectado!");

    // Iniciar reprodução (autoplay-policy=no-user-gesture-required no launch)
    await page.evaluate(() => {
      const video = document.querySelector('video');
      if (video) {
        video.muted = true;
        video.play();
      }
    });
    console.log("▶️ Playback iniciado.");

    // Coletar métricas do player via JS periodicamente
    const playerMetrics = [];
    const collectInterval = setInterval(async () => {
      try {
        const m = await page.evaluate(() => {
          const ts = new Date().toISOString();
          const video = document.querySelector('video');
          const bitrate = document.getElementById('m-bitrate')?.textContent || '-';
          const buffer = document.getElementById('m-buffer')?.textContent || '-';
          const switches = document.getElementById('m-switches')?.textContent || '0';
          const stalls = document.getElementById('m-stalls')?.textContent || '0';
          const stallDur = document.getElementById('m-stall-duration')?.textContent || '0s';
          const resolution = document.getElementById('m-resolution')?.textContent || '-';
          const throughput = document.getElementById('m-throughput')?.textContent || '-';
          const abr = document.getElementById('m-abr')?.textContent || '-';
          return `${ts},${video?.currentTime || 0},${bitrate},${buffer},${switches},${stalls},${stallDur},${resolution},${throughput},${abr}`;
        });
        playerMetrics.push(m);
      } catch (e) { /* ignore */ }
    }, 2000);

    // Aguardar playback terminar OU timeout máximo
    console.log(`⏳ Capturando tráfego (máx ${MAX_TIMEOUT_SEC}s, termina antes se playback concluir)...`);
    const playbackFinished = new Promise(resolve => {
      page.on('console', msg => {
        if (msg.text().includes('Playback finalizado')) {
          console.log('🎯 Playback concluído — encerrando captura.');
          resolve();
        }
      });
    });
    const maxTimeout = new Promise(resolve => setTimeout(() => {
      console.log(`⏰ Timeout máximo (${MAX_TIMEOUT_SEC}s) atingido — encerrando captura.`);
      resolve();
    }, MAX_TIMEOUT_SEC * 1000));

    await Promise.race([playbackFinished, maxTimeout]);

    clearInterval(collectInterval);

    // Salvar métricas do player
    const csvHeader = 'timestamp,time_s,bitrate,buffer_s,switches,stalls,stall_duration,resolution,throughput,abr_algo';
    fs.writeFileSync(metricsPath, csvHeader + '\n' + playerMetrics.join('\n'));
    console.log(`📊 Métricas do player salvas: ${metricsPath}`);

    await har.stop();
    console.log(`✅ HAR salvo: ${harPath}`);

    // Upload para o servidor de vídeo (mesma rede local, sem MTU)
    console.log(`📤 Enviando HAR para ${COLLECTOR_URL}...`);
    try {
      execSync(`curl -s --connect-timeout 5 --max-time 15 -F "har=@${harPath}" -F "client=${CLIENT_ID}" ${COLLECTOR_URL}`, { stdio: 'inherit' });
      execSync(`curl -s --connect-timeout 5 --max-time 15 -F "csv=@${metricsPath}" -F "client=${CLIENT_ID}" ${COLLECTOR_URL}`, { stdio: 'inherit' });
      console.log("✅ Upload concluído.");
    } catch (e) {
      console.log("⚠️ Upload falhou — arquivos salvos localmente:", HAR_DIR);
    }

  } catch (err) {
    console.error("❌ Erro:", err.message || err);
  } finally {
    await browser.close();
    console.log("👋 Finalizado.");
  }
})();

